# Copy to .env for local development. In production these are set as
# environment variables on the cPanel Node.js app.

NODE_ENV=development
PORT=3000

# `npm run db` at the repo root starts this database.
DATABASE_URL=postgresql://aischool:aischool@localhost:5433/aischool

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the API with cookies.
# Leave empty when the web app is served from the same host as the API.
CORS_ORIGINS=http://localhost:5173

# Apply pending migrations when the API starts (used on shared hosting,
# where the database only accepts local connections).
RUN_MIGRATIONS_ON_BOOT=false

# One-time setup on hosting without a shell (safe to leave set; each only
# acts when needed). Remove BOOTSTRAP_OWNER_PASSWORD after the first start.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
SEED_DEMO_ON_BOOT=false

# --- AI providers: set any one or more. The router tries them in
# AI_PROVIDER_ORDER and falls through to the next on outages/rate limits.
AI_PROVIDER_ORDER=anthropic,openai,gemini

# Anthropic: standard tier = claude-haiku-4-5, advanced = claude-opus-5
# (override with ANTHROPIC_MODEL_STANDARD / ANTHROPIC_MODEL_ADVANCED).
ANTHROPIC_API_KEY=

# OpenAI and Gemini need their model IDs set explicitly.
OPENAI_API_KEY=
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_ADVANCED=
GEMINI_API_KEY=
GEMINI_MODEL_STANDARD=
GEMINI_MODEL_ADVANCED=

# USD per million tokens for models without a built-in price, e.g.
# {"some-model":{"input":0.5,"output":2}}. Unpriced models aren't counted
# against budgets.
AI_PRICES=
# Default monthly AI budget per school in USD when the school has none set.
AI_DEFAULT_MONTHLY_BUDGET_USD=25
