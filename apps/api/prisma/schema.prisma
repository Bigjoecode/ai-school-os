}

model WebsiteAlbum {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String?
  date        DateTime? @db.Date
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  photos WebsitePhoto[]

  @@index([tenantId])
  @@map("website_albums")
}

model WebsitePhoto {
  id        String   @id @default(cuid())
  tenantId  String
  albumId   String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  album  WebsiteAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, sortOrder])
  @@map("website_photos")
}

model WebsiteDownload {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  /// PROSPECTUS, FORMS, CALENDAR, POLICIES, FEES, NEWSLETTER, OTHER
  category    String   @default("OTHER")
  fileUrl     String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("website_downloads")
}

/// A message sent through the website's contact form.
model WebsiteMessage {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  subject   String
  message   String
  /// NEW, READ, REPLIED, ARCHIVED
  status    String   @default("NEW")
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("website_messages")
}

/// A code that lets a parent check one student's published result for one term on the website.
model ResultAccessCode {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  termId    String
  code      String
  uses      Int      @default(0)
  maxUses   Int      @default(5)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
  @@unique([tenantId, code])
  @@map("result_access_codes")
}

// ============================================================== SaaS console

enum PlatformInvoiceStatus {
  OPEN
  PAID
  VOID
}

/// What a school owes the platform: one per subscription period, or ad hoc.
model PlatformInvoice {
  id             String                @id @default(cuid())
  number         String                @unique
  tenantId       String
  subscriptionId String?
  description    String
  periodStart    DateTime?
  periodEnd      DateTime?
  seats          Int                   @default(0)
  unitKobo       Int                   @default(0)
  discountKobo   Int                   @default(0)
  amountKobo     Int
  paidKobo       Int                   @default(0)
  currency       String                @default("NGN")
  /// SCHOOL | STUDENT_AI | EXAM: which revenue line the invoice posts to.
  domain         String                @default("SCHOOL")
  status         PlatformInvoiceStatus @default(OPEN)
  issuedAt       DateTime              @default(now())
  dueDate        DateTime              @db.Date
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     PlatformPayment[]

  @@unique([subscriptionId, periodStart])
  @@index([tenantId, issuedAt])
  @@index([status, dueDate])
  @@map("platform_invoices")
}

/// PAYSTACK payments start PENDING and settle on verify or webhook; others are recorded by finance staff.
model PlatformPayment {
  id           String    @id @default(cuid())
  tenantId     String
  invoiceId    String
  amountKobo   Int
  method       String
  status       String    @default("SUCCESS")
  reference    String    @unique
  paidAt       DateTime?
  recordedById String?
  note         String?
  createdAt    DateTime  @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("platform_payments")
}

/// MODULE flags follow the school's plan; BETA flags roll out by percentage.
/// enabled=false switches a flag off for every school, overrides included.
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  kind           String   @default("BETA")
  enabled        Boolean  @default(true)
  rolloutPercent Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  overrides TenantFeature[]

  @@map("feature_flags")
}

model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String
  flagKey   String
  enabled   Boolean
  note      String?
  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flag   FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, flagKey])
  @@map("tenant_features")
}

/// Request counts per school per day ("platform" for signed-out and console traffic).
model ApiUsageDaily {
  id           String   @id @default(cuid())
  scope        String
  day          DateTime @db.Date
  requests     Int      @default(0)
  clientErrors Int      @default(0)
  serverErrors Int      @default(0)
  totalMs      BigInt   @default(0)
  maxMs        Int      @default(0)

  @@unique([scope, day])
  @@index([day])
  @@map("api_usage_daily")
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id               String       @id @default(cuid())
  number           Int          @unique @default(autoincrement())
  tenantId         String
  openedById       String?
  subject          String
  category         String       @default("OTHER")
  priority         String       @default("NORMAL")
  status           TicketStatus @default(OPEN)
  assignedToId     String?
  lastMessageAt    DateTime     @default(now())
  /// The school spoke last, so support owes a reply.
  awaitingPlatform Boolean      @default(true)
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  openedBy   User?            @relation("TicketOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  assignedTo User?            @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([tenantId, status])
  @@index([status, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id @default(cuid())
  ticketId     String
  tenantId     String
  authorId     String?
  fromPlatform Boolean  @default(false)
  /// Visible to platform staff only.
  internal     Boolean  @default(false)
  body         String
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ============================================================== Phase 15: parent-paid layer
//
// Three ways to pay (school SaaS, parent subscriptions, school sponsorships)
// all end in StudentEntitlement rows; features only ever check entitlements.

/// Something a parent (or a school, as a sponsor) can buy.
model Product {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  tagline         String?
  description     String?
  /// AI | EXAM
  kind            String
  /// Entitlement keys granted to each covered student (packages/shared ENTITLEMENTS).
  entitlements    String[]
  priceKobo       Int
  /// Per student, when a school sponsors it. Null = not offered to schools.
  schoolPriceKobo Int?
  /// TERM | MONTH | YEAR | ONE_OFF
  period          String   @default("TERM")
  periodMonths    Int      @default(4)
  /// Children one purchase covers (a family plan covers several).
  maxChildren     Int      @default(1)
  /// Tutor sessions per access period, for AI products.
  aiSessions      Int?
  features        String[]
  isActive        Boolean  @default(true)
  isPublic        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions ConsumerSubscription[]
  orders        ConsumerOrder[]
  sponsorships  Sponsorship[]

  @@map("products")
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  percentOff     Int?
  amountOffKobo  Int?
  /// Empty = every product.
  productCodes   String[]
  maxRedemptions Int?
  redemptions    Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@map("coupons")
}

/// A parent's subscription, paid with the platform's Paystack account. Covers
/// one or more of the parent's children, possibly in different schools.
model ConsumerSubscription {
  id                 String    @id @default(cuid())
  userId             String
  productId          String
  /// PENDING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  status             String    @default("PENDING")
  priceKobo          Int
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  autoRenew          Boolean   @default(true)
  cancelAtPeriodEnd  Boolean   @default(false)
  /// Paystack reusable authorization (encrypted) for renewals.
  authorizationEnc   String?
  cardHint           String?
  email              String
  couponCode         String?
  renewalAttempts    Int       @default(0)
  lastRenewalAttempt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product                       @relation(fields: [productId], references: [id])
  students ConsumerSubscriptionStudent[]
  orders   ConsumerOrder[]

  @@index([userId])
  @@index([status, currentPeriodEnd])
  @@map("consumer_subscriptions")
}

model ConsumerSubscriptionStudent {
  id             String @id @default(cuid())
  subscriptionId String
  studentId      String
  tenantId       String

  subscription ConsumerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, studentId])
  @@index([studentId])
  @@map("consumer_subscription_students")
}

/// One checkout or renewal charge.
model ConsumerOrder {
  id             String    @id @default(cuid())
  reference      String    @unique
  userId         String
  productId      String
  subscriptionId String?
  /// NEW | RENEWAL
  kind           String    @default("NEW")
  studentIds     String[]
  amountKobo     Int
  discountKobo   Int       @default(0)
  feeKobo        Int?
  couponCode     String?
  /// PENDING | PAID | FAILED | REFUNDED | PARTIALLY_REFUNDED
  status         String    @default("PENDING")
  refundedKobo   Int       @default(0)
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id])
  subscription ConsumerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@map("consumer_orders")
}

/// A school paying for AI or exam prep for whole classes; billed as a platform invoice.
model Sponsorship {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String
  title             String
  classArmIds       String[]
  seats             Int
  unitKobo          Int
  totalKobo         Int
  startsAt          DateTime
  endsAt            DateTime
  /// ACTIVE | CANCELLED | EXPIRED
  status            String   @default("ACTIVE")
  platformInvoiceId String?
  createdById       String?
  createdAt         DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@map("sponsorships")
}

/// What a student may use, and until when. Basic AI is implicit (from the school's plan).
model StudentEntitlement {
  id                     String   @id @default(cuid())
  tenantId               String
  studentId              String
  key                    String
  /// PARENT | SCHOOL | PLATFORM
  source                 String
  consumerSubscriptionId String?
  sponsorshipId          String?
  productId              String?
  aiSessions             Int?
  startsAt               DateTime
  endsAt                 DateTime
  /// ACTIVE | REVOKED
  status                 String   @default("ACTIVE")
  note                   String?
  createdAt              DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status, endsAt])
  @@index([consumerSubscriptionId])
  @@index([sponsorshipId])
  @@map("student_entitlements")
}

/// Tutor sessions used per student per allowance window.
model StudentAiUsage {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  periodKey String
  units     Int      @default(0)
  deepUnits Int      @default(0)
  lastAt    DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, periodKey])
  @@map("student_ai_usage")
}

/// What the tutor has learned about how a student learns (not their records).
model StudentMemory {
  id         String   @id @default(cuid())
  tenantId   String
  studentId  String
  /// STRENGTH | STRUGGLE | PREFERENCE | GOAL | NOTE
  kind       String
  content    String
  confidence Float    @default(0.7)
  /// AI | TEACHER | STUDENT | PARENT
  source     String   @default("AI")
  evidence   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, active])
  @@map("student_memories")
}

/// The platform syllabus graph: subject → topic → subtopic. Shared by every school.
model SyllabusTopic {
  id       String  @id @default(cuid())
  subject  String
  /// PRIMARY | JUNIOR | SENIOR
  level    String
  name     String
  parentId String?
  order    Int     @default(0)

  parent    SyllabusTopic?  @relation("TopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  SyllabusTopic[] @relation("TopicTree")
  mastery   MasteryRecord[]
  questions ExamQuestion[]

  @@unique([subject, level, name])
  @@index([subject])
  @@map("syllabus_topics")
}

/// A student's mastery of one topic, from practice, quizzes and tutor evidence.
model MasteryRecord {
  id             String    @id @default(cuid())
  tenantId       String
  studentId      String
  topicId        String
  score          Int
  confidence     Float     @default(0.3)
  attempts       Int       @default(0)
  correct        Int       @default(0)
  lastEvidenceAt DateTime?
  updatedAt      DateTime  @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic   SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@map("mastery_records")
}

model StudyPlan {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  title     String
  goal      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  items     Json
  /// ACTIVE | DONE | ARCHIVED
  status    String   @default("ACTIVE")
  source    String   @default("AI")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@map("study_plans")
}

model FlashcardDeck {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  title     String
  subject   String
  topic     String?
  cards     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("flashcard_decks")
}

/// Practice sets, AI quizzes and timed mock exams. Questions are snapshotted
/// with answers server-side; students only see answers after submitting.
model PracticeAttempt {
  id              String    @id @default(cuid())
  tenantId        String
  studentId       String
  /// PRACTICE | MOCK | AI_QUIZ
  mode            String
  exam            String?
  subject         String?
  topicId         String?
  title           String
  questions       Json
  answers         Json?
  score           Int?
  total           Int
  durationMinutes Int?
  perTopic        Json?
  review          String?
  startedAt       DateTime  @default(now())
  endsAt          DateTime?
  submittedAt     DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startedAt])
  @@map("practice_attempts")
}

/// The Exam Academy bank, shared by every school. AI drafts stay DRAFT until a person publishes them.
model ExamQuestion {
  id           String   @id @default(cuid())
  exam         String
  subject      String
  topicId      String?
  year         Int?
  stem         String
  options      Json
  answer       Int
  explanation  String?
  difficulty   String   @default("MEDIUM")
  /// LICENSED | AUTHORED | AI_REVIEWED
  source       String   @default("AUTHORED")
  /// DRAFT | PUBLISHED | RETIRED
  status       String   @default("DRAFT")
  createdById  String?
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topic SyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([exam, subject, status])
  @@map("exam_questions")
}

/// A school document the AI may answer from (handbook, fee policy, calendar…).
model KbDocument {
  id           String   @id @default(cuid())
  tenantId     String
  title        String
  /// PUBLIC | PARENTS | STAFF
  audience     String   @default("PARENTS")
  fileId       String?
  filename     String?
  /// PROCESSING | READY | FAILED
  status       String   @default("PROCESSING")
  error        String?
  chars        Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KbChunk[]

  @@index([tenantId])
  @@map("kb_documents")
}

model KbChunk {
  id         String  @id @default(cuid())
  tenantId   String
  documentId String
  idx        Int
  heading    String?
  text       String

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("kb_chunks")
}

/// Double-entry ledger across all three revenue domains. Every money event
/// posts balanced lines under one txnId.
model LedgerEntry {
  id         String   @id @default(cuid())
  txnId      String
  account    String
  debitKobo  Int      @default(0)
  creditKobo Int      @default(0)
  currency   String   @default("NGN")
  /// SCHOOL | STUDENT_AI | EXAM
  domain     String
  sourceType String
  sourceId   String
  tenantId   String?
  userId     String?
  memo       String
  createdAt  DateTime @default(now())

  @@index([txnId])
  @@index([account, createdAt])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

model Refund {
  id          String    @id @default(cuid())
  /// CONSUMER_ORDER | PLATFORM_PAYMENT
  sourceType  String
  sourceId    String
  amountKobo  Int
  reason      String
  /// PENDING | PROCESSED | FAILED
  status      String    @default("PENDING")
  providerRef String?
  createdById String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([sourceType, sourceId])
  @@map("refunds")
}

/// Platform-wide settings edited in the console (e.g. "ai": which models each tier uses, and their prices).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}
