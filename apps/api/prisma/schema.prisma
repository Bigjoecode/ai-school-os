// AI School OS — data model.
//
// Multi-tenancy: every school is a Tenant. Every tenant-owned table carries a
// non-null `tenantId`; the API's tenant-scoped Prisma client adds it to every
// query automatically (see src/prisma/tenant-scope.ts), so a query can never
// reach across schools by accident.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================== platform

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BillingPeriod {
  PER_SESSION
  PER_TERM
  MONTHLY
  ANNUAL
}

/// A price list entry. Billing is modelled as per-student-per-period plus
/// optional add-ons, so pricing can change without code changes.
model Plan {
  id                  String        @id @default(cuid())
  code                String        @unique
  name                String
  description         String?
  pricePerStudentKobo Int           @default(0)
  billingPeriod       BillingPeriod @default(PER_SESSION)
  aiMonthlyBudgetUsd  Decimal?      @db.Decimal(10, 2)
  features            String[]
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id                   String       @id @default(cuid())
  slug                 String       @unique
  name                 String
  shortName            String?
  motto                String?
  status               TenantStatus @default(TRIAL)
  logoUrl              String?
  primaryColor         String?
  email                String?
  phone                String?
  address              String?
  country              String       @default("NG")
  currency             String       @default("NGN")
  timezone             String       @default("Africa/Lagos")
  planId               String?
  trialEndsAt          DateTime?
  aiMonthlyBudgetUsd   Decimal?     @db.Decimal(10, 2)
  /// [{ key, name, maxScore }] — how a term's score is made up (CA1, CA2, Exam…).
  /// Null means the platform default (see packages/shared DEFAULT_ASSESSMENT_COMPONENTS).
  assessmentComponents Json?
  /// [{ grade, min, remark }] highest band first. Null means the WAEC-style default.
  gradingScale         Json?
  /// { days: [1..7], periods: [{ label, start, end, kind }] }. Null means the default day.
  bellSchedule         Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  plan                Plan?                 @relation(fields: [planId], references: [id])
  domains             TenantDomain[]
  subscriptions       Subscription[]
  memberships         Membership[]
  roles               Role[]
  sessions            AuthSession[]
  auditLogs           AuditLog[]
  files               FileObject[]
  notifications       Notification[]
  branches            Branch[]
  academicSessions    AcademicSession[]
  terms               Term[]
  classLevels         ClassLevel[]
  classArms           ClassArm[]
  subjects            Subject[]
  classSubjects       ClassSubject[]
  students            Student[]
  guardians           Guardian[]
  studentGuardians    StudentGuardian[]
  staff               Staff[]
  aiUsage             AiUsage[]
  aiConversations     AiConversation[]
  aiMessages          AiMessage[]
  curricula           Curriculum[]
  curriculumUnits     CurriculumUnit[]
  schemes             SchemeOfWork[]
  schemeWeeks         SchemeWeek[]
  lessonPlans         LessonPlan[]
  aiJobs              AiJob[]
  questions           Question[]
  examPapers          ExamPaper[]
  examPaperItems      ExamPaperItem[]
  scores              Score[]
  reportCards         ReportCard[]
  rooms               Room[]
  staffUnavailability StaffUnavailability[]
  timetables          Timetable[]
  timetableEntries    TimetableEntry[]

  @@map("tenants")
}

/// Hostnames that resolve to a school: greenfield.aischool.ng,
/// portal.greenfieldschool.com, …
model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String
  hostname   String    @unique
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  studentSeats       Int                @default(0)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

// ============================================================== identity

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// A person who can sign in. Global across schools: one parent can belong to
/// two schools through two memberships.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  platformRole PlatformRole?
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships   Membership[]
  sessions      AuthSession[]
  auditLogs     AuditLog[]
  notifications Notification[]
  students      Student[]
  guardians     Guardian[]
  staff         Staff[]
  files         FileObject[]
  aiUsage       AiUsage[]
  conversations AiConversation[]
  curricula     Curriculum[]
  schemes       SchemeOfWork[]
  lessonPlans   LessonPlan[]

  @@map("users")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

/// A user's place in one school, and the roles they hold there.
model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A named set of permissions within a school. System roles are copied in when
/// a school is created and can be edited; schools can add custom roles.
model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members MembershipRole[]

  @@unique([tenantId, key])
  @@map("roles")
}

model MembershipRole {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

/// A refresh-token session. Tokens rotate on every refresh; reuse of a
/// rotated token revokes the whole family.
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String?
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  summary     String
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model FileObject {
  id           String   @id @default(cuid())
  tenantId     String
  storageKey   String   @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("files")
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

// ============================================================== school core

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArms ClassArm[]
  students  Student[]

  @@unique([tenantId, code])
  @@map("branches")
}

model AcademicSession {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms  Term[]

  @@unique([tenantId, name])
  @@map("academic_sessions")
}

model Term {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  name      String
  order     Int
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session     AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schemes     SchemeOfWork[]
  examPapers  ExamPaper[]
  scores      Score[]
  reportCards ReportCard[]
  timetables  Timetable[]

  @@unique([sessionId, order])
  @@index([tenantId])
  @@map("terms")
}

/// A year group: JSS 1, SS 2, Primary 4…
model ClassLevel {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  stage     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arms       ClassArm[]
  curricula  Curriculum[]
  schemes    SchemeOfWork[]
  questions  Question[]
  examPapers ExamPaper[]

  @@unique([tenantId, code])
  @@map("class_levels")
}

/// A class section: JSS 1 A, JSS 1 B…
model ClassArm {
  id             String   @id @default(cuid())
  tenantId       String
  classLevelId   String
  branchId       String?
  name           String
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classLevel       ClassLevel       @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  classTeacher     Staff?           @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students         Student[]
  subjects         ClassSubject[]
  lessonPlans      LessonPlan[]
  scores           Score[]
  reportCards      ReportCard[]
  timetableEntries TimetableEntry[]

  @@unique([classLevelId, name])
  @@index([tenantId])
  @@map("class_arms")
}

model Subject {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  category  String?
  isCore    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes          ClassSubject[]
  curricula        Curriculum[]
  schemes          SchemeOfWork[]
  lessonPlans      LessonPlan[]
  questions        Question[]
  examPapers       ExamPaper[]
  scores           Score[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, code])
  @@map("subjects")
}

/// Which subject is taught in which class, and by whom. The timetable engine
/// and teacher workloads build on this.
model ClassSubject {
  id             String  @id @default(cuid())
  tenantId       String
  classArmId     String
  subjectId      String
  teacherId      String?
  /// Lessons of this subject per week for this class (0 = not timetabled).
  periodsPerWeek Int     @default(0)
  /// A room kind the lessons need ("LAB", "ICT"…); null = the class's own room.
  roomKind       String?
  /// Timetable one of the week's lessons as two consecutive periods.
  doublePeriod   Boolean @default(false)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Staff?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classArmId, subjectId])
  @@index([tenantId])
  @@map("class_subjects")
}

// ============================================================== people

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
}

model Student {
  id              String        @id @default(cuid())
  tenantId        String
  branchId        String?
  userId          String?
  classArmId      String?
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String
  gender          Gender
  dateOfBirth     DateTime?     @db.Date
  status          StudentStatus @default(ACTIVE)
  admittedOn      DateTime      @default(now()) @db.Date
  photoUrl        String?
  address         String?
  medicalNotes    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  classArm    ClassArm?         @relation(fields: [classArmId], references: [id], onDelete: SetNull)
  guardians   StudentGuardian[]
  scores      Score[]
  reportCards ReportCard[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, classArmId])
  @@index([tenantId, lastName])
  @@map("students")
}

model Guardian {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  firstName    String
  lastName     String
  relationship String
  phone        String
  email        String?
  occupation   String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@index([tenantId, lastName])
  @@map("guardians")
}

model StudentGuardian {
  tenantId   String
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([tenantId])
  @@index([guardianId])
  @@map("student_guardians")
}

enum StaffType {
  TEACHING
  NON_TEACHING
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  EXITED
}

model Staff {
  id          String      @id @default(cuid())
  tenantId    String
  userId      String?
  staffNumber String
  firstName   String
  lastName    String
  gender      Gender
  email       String?
  phone       String?
  jobTitle    String
  type        StaffType   @default(TEACHING)
  status      StaffStatus @default(ACTIVE)
  employedOn  DateTime?   @db.Date
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  classesLed       ClassArm[]            @relation("ClassTeacher")
  classSubjects    ClassSubject[]
  lessonPlans      LessonPlan[]
  unavailability   StaffUnavailability[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, staffNumber])
  @@map("staff")
}

// ============================================================== ai

/// One row per model call: who, which feature, which model, tokens and cost.
/// Budgets and per-plan limits read from here.
model AiUsage {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  agent        String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

model AiConversation {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  agent     String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([tenantId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  provider       String?
  model          String?
  createdAt      DateTime @default(now())

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ============================================================== academic engine
//
// Curriculum (what a subject covers in a year, week by week)
//   → Scheme of Work (one term of it, on real dates)
//     → Lesson Plan (one lesson, for one class).
// Each can be written by hand or generated by AI; AI generation runs in the
// background and is tracked with `generation`.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentSource {
  MANUAL
  AI
}

enum GenerationState {
  NONE
  QUEUED
  RUNNING
  FAILED
  DONE
}

model Curriculum {
  id              String          @id @default(cuid())
  tenantId        String
  subjectId       String
  classLevelId    String
  version         Int             @default(1)
  title           String
  overview        String?
  status          ContentStatus   @default(DRAFT)
  source          ContentSource   @default(MANUAL)
  generation      GenerationState @default(NONE)
  generationError String?
  /// What the author asked the AI for, kept so a version can be regenerated.
  guidance        String?
  weeksPerTerm    Int             @default(11)
  createdById     String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel       @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  createdBy  User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  units      CurriculumUnit[]
  schemes    SchemeOfWork[]

  @@unique([subjectId, classLevelId, version])
  @@index([tenantId])
  @@map("curricula")
}

/// One week of a curriculum.
model CurriculumUnit {
  id           String   @id @default(cuid())
  tenantId     String
  curriculumId String
  termOrder    Int
  week         Int
  topic        String
  subtopics    String[]
  objectives   String[]
  activities   String[]
  resources    String[]
  assessment   String[]

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, termOrder, week])
  @@index([tenantId])
  @@map("curriculum_units")
}

model SchemeOfWork {
  id              String          @id @default(cuid())
  tenantId        String
  subjectId       String
  classLevelId    String
  termId          String
  curriculumId    String?
  title           String
  status          ContentStatus   @default(DRAFT)
  source          ContentSource   @default(MANUAL)
  generation      GenerationState @default(NONE)
  generationError String?
  guidance        String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel   @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  term       Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  curriculum Curriculum?  @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  weeks      SchemeWeek[]

  @@unique([subjectId, classLevelId, termId])
  @@index([tenantId])
  @@map("schemes_of_work")
}

model SchemeWeek {
  id         String    @id @default(cuid())
  tenantId   String
  schemeId   String
  week       Int
  startsOn   DateTime? @db.Date
  topic      String
  subtopics  String[]
  objectives String[]
  activities String[]
  resources  String[]
  evaluation String[]

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheme      SchemeOfWork @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  lessonPlans LessonPlan[]

  @@unique([schemeId, week])
  @@index([tenantId])
  @@map("scheme_weeks")
}

enum LessonStatus {
  DRAFT
  READY
  DELIVERED
}

model LessonPlan {
  id              String          @id @default(cuid())
  tenantId        String
  subjectId       String
  classArmId      String
  schemeWeekId    String?
  teacherId       String?
  createdById     String?
  topic           String
  date            DateTime?       @db.Date
  durationMinutes Int             @default(40)
  objectives      String[]
  priorKnowledge  String?
  materials       String[]
  /// [{ title, minutes, teacherActivity, learnerActivity }]
  steps           Json            @default("[]")
  /// { support, core, stretch } — the same lesson pitched three ways.
  differentiation Json?
  assessment      String[]
  homework        String?
  status          LessonStatus    @default(DRAFT)
  source          ContentSource   @default(MANUAL)
  generation      GenerationState @default(NONE)
  generationError String?
  guidance        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classArm   ClassArm    @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  schemeWeek SchemeWeek? @relation(fields: [schemeWeekId], references: [id], onDelete: SetNull)
  teacher    Staff?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, classArmId, date])
  @@map("lesson_plans")
}

/// A background AI task that produces many records at once (a batch of
/// questions, a class's report-card remarks). Pages poll it for progress.
model AiJob {
  id          String          @id @default(cuid())
  tenantId    String
  kind        String
  state       GenerationState @default(QUEUED)
  error       String?
  params      Json
  /// Short outcome for the UI, e.g. { created: 12 }.
  result      Json?
  createdById String?
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([tenantId, kind, createdAt])
  @@map("ai_jobs")
}

// ============================================================== assessment

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  THEORY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  APPROVED
  RETIRED
}

model Question {
  id           String         @id @default(cuid())
  tenantId     String
  subjectId    String
  classLevelId String
  topic        String
  type         QuestionType
  difficulty   Difficulty     @default(MEDIUM)
  /// The question as the learner sees it.
  stem         String
  /// Choices for multiple-choice (and ["True","False"]); empty otherwise.
  options      String[]
  /// Index into `options` for objective questions.
  correctIndex Int?
  /// Model answer / key points for written questions.
  answer       String?
  /// How marks are awarded, for the marker.
  markingGuide String?
  marks        Int            @default(1)
  status       QuestionStatus @default(DRAFT)
  source       ContentSource  @default(MANUAL)
  aiJobId      String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  aiJob      AiJob?          @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  paperItems ExamPaperItem[]

  @@index([tenantId, subjectId, classLevelId, status])
  @@map("questions")
}

enum PaperStatus {
  DRAFT
  FINAL
}

/// A printable test or exam built from the question bank.
model ExamPaper {
  id              String      @id @default(cuid())
  tenantId        String
  subjectId       String
  classLevelId    String
  termId          String
  /// Which result component it feeds: "ca1", "exam"…
  componentKey    String
  title           String
  instructions    String?
  durationMinutes Int         @default(60)
  status          PaperStatus @default(DRAFT)
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  term       Term            @relation(fields: [termId], references: [id], onDelete: Cascade)
  items      ExamPaperItem[]

  @@index([tenantId, termId])
  @@map("exam_papers")
}

model ExamPaperItem {
  id         String @id @default(cuid())
  tenantId   String
  paperId    String
  questionId String
  order      Int
  /// "A" for objective questions, "B" for written ones.
  section    String @default("A")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paper    ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([paperId, questionId])
  @@index([tenantId])
  @@map("exam_paper_items")
}

/// One student's mark for one component (CA1, Exam…) of one subject in one term.
model Score {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  subjectId    String
  termId       String
  /// The class the student sat in when marked (results stay put if they move).
  classArmId   String
  componentKey String
  score        Decimal  @db.Decimal(5, 2)
  enteredById  String?
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term     Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, termId, componentKey])
  @@index([tenantId, classArmId, termId])
  @@map("scores")
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

/// The per-term report: the scores come from Score rows; this holds what
/// people write on it and whether it has been released to parents.
model ReportCard {
  id              String        @id @default(cuid())
  tenantId        String
  studentId       String
  termId          String
  classArmId      String
  teacherRemark   String?
  remarkSource    ContentSource @default(MANUAL)
  principalRemark String?
  status          ReportStatus  @default(DRAFT)
  publishedAt     DateTime?
  updatedAt       DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term     Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
  @@index([tenantId, classArmId, termId])
  @@map("report_cards")
}

// ============================================================== timetable
//
// The solver (src/timetable/solver.ts) places each class's weekly lessons
// (ClassSubject.periodsPerWeek) into the bell schedule without double-booking
// a class, teacher or room, then improves spread and balance. AI explains
// what couldn't be placed and turns plain-English requests into constraints.

model Room {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  /// CLASSROOM, LAB, ICT, HALL, LIBRARY, WORKSHOP…
  kind      String   @default("CLASSROOM")
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([tenantId, name])
  @@map("rooms")
}

/// A period in the week when a teacher can't be timetabled.
model StaffUnavailability {
  id       String @id @default(cuid())
  tenantId String
  staffId  String
  /// 1 = Monday … 7 = Sunday
  day      Int
  /// Index into the bell schedule's periods.
  period   Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, day, period])
  @@index([tenantId])
  @@map("staff_unavailability")
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Timetable {
  id              String          @id @default(cuid())
  tenantId        String
  termId          String
  name            String
  status          TimetableStatus @default(DRAFT)
  generation      GenerationState @default(NONE)
  generationError String?
  /// The bell schedule it was built against (so later edits don't shift it).
  bellSchedule    Json
  /// Solver report: placed/unplaced counts, reasons, quality scores.
  report          Json?
  createdById     String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term    Term             @relation(fields: [termId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@index([tenantId, termId])
  @@map("timetables")
}

model TimetableEntry {
  id          String  @id @default(cuid())
  tenantId    String
  timetableId String
  classArmId  String
  subjectId   String
  teacherId   String?
  roomId      String?
  day         Int
  period      Int
  /// Part of a double lesson: both halves share a group id.
  doubleGroup String?
  /// Kept in place when the timetable is regenerated.
  locked      Boolean @default(false)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  classArm  ClassArm  @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Staff?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([timetableId, classArmId, day, period])
  @@index([timetableId, teacherId])
  @@index([tenantId])
  @@map("timetable_entries")
}
