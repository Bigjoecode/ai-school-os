// AI School OS — data model.
//
// Multi-tenancy: every school is a Tenant. Every tenant-owned table carries a
// non-null `tenantId`; the API's tenant-scoped Prisma client adds it to every
// query automatically (see src/prisma/tenant-scope.ts), so a query can never
// reach across schools by accident.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================== platform

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BillingPeriod {
  PER_SESSION
  PER_TERM
  MONTHLY
  ANNUAL
}

/// A price list entry. Billing is modelled as per-student-per-period plus
/// optional add-ons, so pricing can change without code changes.
model Plan {
  id                  String        @id @default(cuid())
  code                String        @unique
  name                String
  description         String?
  pricePerStudentKobo Int           @default(0)
  billingPeriod       BillingPeriod @default(PER_SESSION)
  aiMonthlyBudgetUsd  Decimal?      @db.Decimal(10, 2)
  /// Module feature keys the plan includes (packages/shared MODULE_FEATURES). Empty = all modules.
  features            String[]
  maxStudents         Int?
  /// AI tutor sessions per term every student gets with the school (AI Basic).
  studentAiSessions   Int           @default(20)
  isActive            Boolean       @default(true)
  /// Shown on public pricing; private plans are for custom deals.
  isPublic            Boolean       @default(true)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id                   String       @id @default(cuid())
  slug                 String       @unique
  name                 String
  shortName            String?
  motto                String?
  status               TenantStatus @default(TRIAL)
  logoUrl              String?
  primaryColor         String?
  email                String?
  phone                String?
  address              String?
  country              String       @default("NG")
  currency             String       @default("NGN")
  timezone             String       @default("Africa/Lagos")
  planId               String?
  trialEndsAt          DateTime?
  aiMonthlyBudgetUsd   Decimal?     @db.Decimal(10, 2)
  /// [{ key, name, maxScore }] — how a term's score is made up (CA1, CA2, Exam…).
  /// Null means the platform default (see packages/shared DEFAULT_ASSESSMENT_COMPONENTS).
  assessmentComponents Json?
  /// [{ grade, min, remark }] highest band first. Null means the WAEC-style default.
  gradingScale         Json?
  /// { days: [1..7], periods: [{ label, start, end, kind }] }. Null means the default day.
  bellSchedule         Json?
  /// { staffLateAfter: "HH:MM", editWindowDays } — null means the defaults.
  attendanceSettings   Json?
  /// { invoicePrefix, receiptPrefix, defaultDueDays, bankDetails } — null means the defaults.
  financeSettings      Json?
  /// { payeEnabled, pensionEmployeePct, pensionEmployerPct, nhfPct, payslipNote } — null means the defaults.
  hrSettings           Json?
  /// Library loan rules, certificate prefix, ID card validity — null means the defaults.
  operationsSettings   Json?
  /// SMS price, sender name, birthday and event-reminder automations — null means the defaults.
  commsSettings        Json?
  /// Public website content and settings — null means not set up.
  websiteSettings      Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  plan                Plan?                 @relation(fields: [planId], references: [id])
  domains             TenantDomain[]
  subscriptions       Subscription[]
  memberships         Membership[]
  roles               Role[]
  sessions            AuthSession[]
  auditLogs           AuditLog[]
  files               FileObject[]
  notifications       Notification[]
  branches            Branch[]
  academicSessions    AcademicSession[]
  terms               Term[]
  classLevels         ClassLevel[]
  classArms           ClassArm[]
  subjects            Subject[]
  classSubjects       ClassSubject[]
  students            Student[]
  guardians           Guardian[]
  studentGuardians    StudentGuardian[]
  staff               Staff[]
  aiUsage             AiUsage[]
  aiConversations     AiConversation[]
  aiMessages          AiMessage[]
  curricula           Curriculum[]
  curriculumUnits     CurriculumUnit[]
  schemes             SchemeOfWork[]
  schemeWeeks         SchemeWeek[]
  lessonPlans         LessonPlan[]
  aiJobs              AiJob[]
  questions           Question[]
  examPapers          ExamPaper[]
  examPaperItems      ExamPaperItem[]
  scores              Score[]
  reportCards         ReportCard[]
  rooms               Room[]
  staffUnavailability StaffUnavailability[]
  timetables          Timetable[]
  timetableEntries    TimetableEntry[]
  attendanceRegisters AttendanceRegister[]
  studentAttendance   StudentAttendance[]
  staffAttendance     StaffAttendance[]
  feeItems            FeeItem[]
  invoices            Invoice[]
  invoiceLines        InvoiceLine[]
  payments            Payment[]
  expenses            Expense[]
  integrations        TenantIntegration[]
  departments         Department[]
  salaryGrades        SalaryGrade[]
  payProfiles         StaffPayProfile[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  awards              Award[]
  libraryBooks        LibraryBook[]
  libraryLoans        LibraryLoan[]
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  vehicles            Vehicle[]
  transportRoutes     TransportRoute[]
  transportRiders     TransportAssignment[]
  hostels             Hostel[]
  hostelRooms         HostelRoom[]
  hostelAllocations   HostelAllocation[]
  exeats              Exeat[]
  visitors            Visitor[]
  enquiries           Enquiry[]
  studentPickups      StudentPickup[]
  certificates        Certificate[]
  broadcasts          Broadcast[]
  deliveries          Delivery[]
  announcements       Announcement[]
  schoolEvents        SchoolEvent[]
  automationRuns      AutomationRun[]

  liveClasses    LiveClass[]
  liveAttendance LiveAttendance[]
  liveRecordings LiveRecording[]
  homework       Homework[]

  websitePosts     WebsitePost[]
  websiteAlbums    WebsiteAlbum[]
  websitePhotos    WebsitePhoto[]
  websiteDownloads WebsiteDownload[]
  websiteMessages  WebsiteMessage[]
  resultCodes      ResultAccessCode[]

  platformInvoices PlatformInvoice[]
  platformPayments PlatformPayment[]
  featureOverrides TenantFeature[]
  supportTickets   SupportTicket[]
  supportMessages  SupportMessage[]

  consumerCoverage    ConsumerSubscriptionStudent[]
  sponsorships        Sponsorship[]
  studentEntitlements StudentEntitlement[]
  studentAiUsage      StudentAiUsage[]
  studentMemories     StudentMemory[]
  masteryRecords      MasteryRecord[]
  studyPlans          StudyPlan[]
  flashcardDecks      FlashcardDeck[]
  practiceAttempts    PracticeAttempt[]
  kbDocuments         KbDocument[]
  kbChunks            KbChunk[]

  @@map("tenants")
}

/// Hostnames that resolve to a school: greenfield.aischool.ng,
/// portal.greenfieldschool.com, …
model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String
  hostname   String    @unique
  isPrimary  Boolean   @default(false)
  /// PORTAL (sign-in) or WEBSITE (the public site at the root).
  kind       String    @default("PORTAL")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  studentSeats       Int                @default(0)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  /// A negotiated price per student per period, instead of the plan's.
  priceOverrideKobo  Int?
  discountPct        Int                @default(0)
  cancelAtPeriodEnd  Boolean            @default(false)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan              @relation(fields: [planId], references: [id])
  invoices PlatformInvoice[]

  @@index([tenantId])
  @@map("subscriptions")
}

// ============================================================== identity

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  FINANCE_ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// A person who can sign in. Global across schools: one parent can belong to
/// two schools through two memberships.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  platformRole PlatformRole?
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships           Membership[]
  sessions              AuthSession[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  students              Student[]
  guardians             Guardian[]
  staff                 Staff[]
  files                 FileObject[]
  aiUsage               AiUsage[]
  conversations         AiConversation[]
  curricula             Curriculum[]
  schemes               SchemeOfWork[]
  lessonPlans           LessonPlan[]
  ticketsOpened         SupportTicket[]        @relation("TicketOpenedBy")
  ticketsAssigned       SupportTicket[]        @relation("TicketAssignee")
  supportMessages       SupportMessage[]
  consumerSubscriptions ConsumerSubscription[]
  consumerOrders        ConsumerOrder[]

  @@map("users")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

/// A user's place in one school, and the roles they hold there.
model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A named set of permissions within a school. System roles are copied in when
/// a school is created and can be edited; schools can add custom roles.
model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members MembershipRole[]

  @@unique([tenantId, key])
  @@map("roles")
}

model MembershipRole {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

/// A refresh-token session. Tokens rotate on every refresh; reuse of a
/// rotated token revokes the whole family.
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String?
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  summary     String
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model FileObject {
  id           String   @id @default(cuid())
  tenantId     String
  storageKey   String   @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  /// Website files are public; everything else needs sign-in.
  isPublic     Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("files")
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

// ============================================================== school core

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArms ClassArm[]
  students  Student[]

  @@unique([tenantId, code])
  @@map("branches")
}

model AcademicSession {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms  Term[]

  @@unique([tenantId, name])
  @@map("academic_sessions")
}

model Term {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  name      String
  order     Int
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session     AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schemes     SchemeOfWork[]
  examPapers  ExamPaper[]
  scores      Score[]
  reportCards ReportCard[]
  timetables  Timetable[]
  feeItems    FeeItem[]
  invoices    Invoice[]

  resultCodes ResultAccessCode[]

  @@unique([sessionId, order])
  @@index([tenantId])
  @@map("terms")
}

/// A year group: JSS 1, SS 2, Primary 4…
model ClassLevel {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  stage     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arms       ClassArm[]
  curricula  Curriculum[]
  schemes    SchemeOfWork[]
  questions  Question[]
  examPapers ExamPaper[]

  @@unique([tenantId, code])
  @@map("class_levels")
}

/// A class section: JSS 1 A, JSS 1 B…
model ClassArm {
  id             String   @id @default(cuid())
  tenantId       String
  classLevelId   String
  branchId       String?
  name           String
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime @default(now())

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classLevel       ClassLevel           @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  classTeacher     Staff?               @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students         Student[]
  subjects         ClassSubject[]
  lessonPlans      LessonPlan[]
  scores           Score[]
  reportCards      ReportCard[]
  timetableEntries TimetableEntry[]
  registers        AttendanceRegister[]

  liveClasses LiveClass[]
  homework    Homework[]

  @@unique([classLevelId, name])
  @@index([tenantId])
  @@map("class_arms")
}

model Subject {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  category  String?
  isCore    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes          ClassSubject[]
  curricula        Curriculum[]
  schemes          SchemeOfWork[]
  lessonPlans      LessonPlan[]
  questions        Question[]
  examPapers       ExamPaper[]
  scores           Score[]
  timetableEntries TimetableEntry[]

  liveClasses LiveClass[]
  homework    Homework[]

  @@unique([tenantId, code])
  @@map("subjects")
}

/// Which subject is taught in which class, and by whom. The timetable engine
/// and teacher workloads build on this.
model ClassSubject {
  id             String  @id @default(cuid())
  tenantId       String
  classArmId     String
  subjectId      String
  teacherId      String?
  /// Lessons of this subject per week for this class (0 = not timetabled).
  periodsPerWeek Int     @default(0)
  /// A room kind the lessons need ("LAB", "ICT"…); null = the class's own room.
  roomKind       String?
  /// Timetable one of the week's lessons as two consecutive periods.
  doublePeriod   Boolean @default(false)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Staff?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classArmId, subjectId])
  @@index([tenantId])
  @@map("class_subjects")
}

// ============================================================== people

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
}

model Student {
  id              String        @id @default(cuid())
  tenantId        String
  branchId        String?
  userId          String?
  classArmId      String?
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String
  gender          Gender
  dateOfBirth     DateTime?     @db.Date
  status          StudentStatus @default(ACTIVE)
  admittedOn      DateTime      @default(now()) @db.Date
  photoUrl        String?
  address         String?
  medicalNotes    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  classArm     ClassArm?           @relation(fields: [classArmId], references: [id], onDelete: SetNull)
  guardians    StudentGuardian[]
  scores       Score[]
  reportCards  ReportCard[]
  attendance   StudentAttendance[]
  invoices     Invoice[]
  payments     Payment[]
  libraryLoans LibraryLoan[]

  consumerCoverage ConsumerSubscriptionStudent[]
  entitlements     StudentEntitlement[]
  aiUsageWindows   StudentAiUsage[]
  memories         StudentMemory[]
  mastery          MasteryRecord[]
  studyPlans       StudyPlan[]
  flashcardDecks   FlashcardDeck[]
  practiceAttempts PracticeAttempt[]
  transport        TransportAssignment?
  hostelBeds       HostelAllocation[]
  exeats           Exeat[]
  pickups          StudentPickup[]
  certificates     Certificate[]

  liveAttendance LiveAttendance[]

  resultCodes ResultAccessCode[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, classArmId])
  @@index([tenantId, lastName])
  @@map("students")
}

model Guardian {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  firstName    String
  lastName     String
  relationship String
  phone        String
  email        String?
  occupation   String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@index([tenantId, lastName])
  @@map("guardians")
}

model StudentGuardian {
  tenantId   String
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([tenantId])
  @@index([guardianId])
  @@map("student_guardians")
}

enum StaffType {
  TEACHING
  NON_TEACHING
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  EXITED
}

model Staff {
  id             String      @id @default(cuid())
  tenantId       String
  userId         String?
  staffNumber    String
  firstName      String
  lastName       String
  gender         Gender
  email          String?
  phone          String?
  jobTitle       String
  type           StaffType   @default(TEACHING)
  status         StaffStatus @default(ACTIVE)
  employedOn     DateTime?   @db.Date
  departmentId   String?
  dateOfBirth    DateTime?   @db.Date
  address        String?
  qualification  String?
  nextOfKinName  String?
  nextOfKinPhone String?
  exitedOn       DateTime?   @db.Date
  exitReason     String?
  showOnWebsite  Boolean     @default(false)
  websiteBio     String?
  photoUrl       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  department       Department?           @relation("DepartmentStaff", fields: [departmentId], references: [id], onDelete: SetNull)
  departmentsLed   Department[]          @relation("DepartmentHead")
  classesLed       ClassArm[]            @relation("ClassTeacher")
  classSubjects    ClassSubject[]
  lessonPlans      LessonPlan[]
  unavailability   StaffUnavailability[]
  timetableEntries TimetableEntry[]
  attendance       StaffAttendance[]
  payProfile       StaffPayProfile?
  payslips         Payslip[]
  leaveRequests    LeaveRequest[]
  awards           Award[]
  libraryLoans     LibraryLoan[]
  hostelsWarded    Hostel[]
  visitorsHosted   Visitor[]             @relation("VisitorHost")
  certificates     Certificate[]

  liveClasses LiveClass[]
  homework    Homework[]

  @@unique([tenantId, staffNumber])
  @@map("staff")
}

// ============================================================== ai

/// One row per model call: who, which feature, which model, tokens and cost.
/// Budgets and per-plan limits read from here.
/// tenantId is null for the operator console's own AI calls.
model AiUsage {
  id               String   @id @default(cuid())
  tenantId         String?
  userId           String?
  agent            String
  provider         String
  model            String
  /// Uncached input tokens (cached reads and writes are counted separately).
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  /// Student AI: whose allowance this used, and on which tier.
  studentId        String?
  aiTier           String?
  latencyMs        Int      @default(0)
  success          Boolean  @default(true)
  error            String?
  createdAt        DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

model AiConversation {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  /// The tutor's conversations belong to a student.
  studentId String?
  agent     String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([tenantId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  provider       String?
  model          String?
  createdAt      DateTime @default(now())

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ============================================================== academic engine
//
// Curriculum (what a subject covers in a year, week by week)
//   → Scheme of Work (one term of it, on real dates)
//     → Lesson Plan (one lesson, for one class).
// Each can be written by hand or generated by AI; AI generation runs in the
// background and is tracked with `generation`.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentSource {
  MANUAL
  AI
}

enum GenerationState {
  NONE
  QUEUED
  RUNNING
  FAILED
  DONE
}

model Curriculum {
  id              String          @id @default(cuid())
  tenantId        String
  subjectId       String
  classLevelId    String
  version         Int             @default(1)
  title           String
  overview        String?
  status          ContentStatus   @default(DRAFT)
  source          ContentSource   @default(MANUAL)
  generation      GenerationState @default(NONE)
  generationError String?
  /// What the author asked the AI for, kept so a version can be regenerated.
  guidance        String?
  weeksPerTerm    Int             @default(11)
  createdById     String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel       @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  createdBy  User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  units      CurriculumUnit[]
  schemes    SchemeOfWork[]

  @@unique([subjectId, classLevelId, version])
  @@index([tenantId])
  @@map("curricula")
}

/// One week of a curriculum.
model CurriculumUnit {
  id           String   @id @default(cuid())
  tenantId     String
  curriculumId String
  termOrder    Int
  week         Int
  topic        String
  subtopics    String[]
  objectives   String[]
  activities   String[]
  resources    String[]
  assessment   String[]

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, termOrder, week])
  @@index([tenantId])
  @@map("curriculum_units")
}

model SchemeOfWork {
  id              String          @id @default(cuid())
  tenantId        String
  subjectId       String
  classLevelId    String
  termId          String
  curriculumId    String?
  title           String
  status          ContentStatus   @default(DRAFT)
  source          ContentSource   @default(MANUAL)
  generation      GenerationState @default(NONE)
  generationError String?
  guidance        String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel   @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  term       Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  curriculum Curriculum?  @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  weeks      SchemeWeek[]

  @@unique([subjectId, classLevelId, termId])
  @@index([tenantId])
  @@map("schemes_of_work")
}

model SchemeWeek {
  id         String    @id @default(cuid())
  tenantId   String
  schemeId   String
  week       Int
  startsOn   DateTime? @db.Date
  topic      String
  subtopics  String[]
  objectives String[]
  activities String[]
  resources  String[]
  evaluation String[]

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheme      SchemeOfWork @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  lessonPlans LessonPlan[]

  @@unique([schemeId, week])
  @@index([tenantId])
  @@map("scheme_weeks")
}

enum LessonStatus {
  DRAFT
  READY
  DELIVERED
}

model LessonPlan {
  id              String          @id @default(cuid())
  tenantId        String
  subjectId       String
  classArmId      String
  schemeWeekId    String?
  teacherId       String?
  createdById     String?
  topic           String
  date            DateTime?       @db.Date
  durationMinutes Int             @default(40)
  objectives      String[]
  priorKnowledge  String?
  materials       String[]
  /// [{ title, minutes, teacherActivity, learnerActivity }]
  steps           Json            @default("[]")
  /// { support, core, stretch } — the same lesson pitched three ways.
  differentiation Json?
  assessment      String[]
  homework        String?
  status          LessonStatus    @default(DRAFT)
  source          ContentSource   @default(MANUAL)
  generation      GenerationState @default(NONE)
  generationError String?
  guidance        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classArm   ClassArm    @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  schemeWeek SchemeWeek? @relation(fields: [schemeWeekId], references: [id], onDelete: SetNull)
  teacher    Staff?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  liveClasses LiveClass[]

  @@index([tenantId, classArmId, date])
  @@map("lesson_plans")
}

/// A background AI task that produces many records at once (a batch of
/// questions, a class's report-card remarks). Pages poll it for progress.
model AiJob {
  id          String          @id @default(cuid())
  tenantId    String
  kind        String
  state       GenerationState @default(QUEUED)
  error       String?
  params      Json
  /// Short outcome for the UI, e.g. { created: 12 }.
  result      Json?
  createdById String?
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([tenantId, kind, createdAt])
  @@map("ai_jobs")
}

// ============================================================== assessment

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  THEORY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  APPROVED
  RETIRED
}

model Question {
  id           String         @id @default(cuid())
  tenantId     String
  subjectId    String
  classLevelId String
  topic        String
  type         QuestionType
  difficulty   Difficulty     @default(MEDIUM)
  /// The question as the learner sees it.
  stem         String
  /// Choices for multiple-choice (and ["True","False"]); empty otherwise.
  options      String[]
  /// Index into `options` for objective questions.
  correctIndex Int?
  /// Model answer / key points for written questions.
  answer       String?
  /// How marks are awarded, for the marker.
  markingGuide String?
  marks        Int            @default(1)
  status       QuestionStatus @default(DRAFT)
  source       ContentSource  @default(MANUAL)
  aiJobId      String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  aiJob      AiJob?          @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  paperItems ExamPaperItem[]

  @@index([tenantId, subjectId, classLevelId, status])
  @@map("questions")
}

enum PaperStatus {
  DRAFT
  FINAL
}

/// A printable test or exam built from the question bank.
model ExamPaper {
  id              String      @id @default(cuid())
  tenantId        String
  subjectId       String
  classLevelId    String
  termId          String
  /// Which result component it feeds: "ca1", "exam"…
  componentKey    String
  title           String
  instructions    String?
  durationMinutes Int         @default(60)
  status          PaperStatus @default(DRAFT)
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  term       Term            @relation(fields: [termId], references: [id], onDelete: Cascade)
  items      ExamPaperItem[]

  @@index([tenantId, termId])
  @@map("exam_papers")
}

model ExamPaperItem {
  id         String @id @default(cuid())
  tenantId   String
  paperId    String
  questionId String
  order      Int
  /// "A" for objective questions, "B" for written ones.
  section    String @default("A")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paper    ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([paperId, questionId])
  @@index([tenantId])
  @@map("exam_paper_items")
}

/// One student's mark for one component (CA1, Exam…) of one subject in one term.
model Score {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  subjectId    String
  termId       String
  /// The class the student sat in when marked (results stay put if they move).
  classArmId   String
  componentKey String
  score        Decimal  @db.Decimal(5, 2)
  enteredById  String?
  updatedAt    DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term     Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, termId, componentKey])
  @@index([tenantId, classArmId, termId])
  @@map("scores")
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

/// The per-term report: the scores come from Score rows; this holds what
/// people write on it and whether it has been released to parents.
model ReportCard {
  id              String        @id @default(cuid())
  tenantId        String
  studentId       String
  termId          String
  classArmId      String
  teacherRemark   String?
  remarkSource    ContentSource @default(MANUAL)
  principalRemark String?
  status          ReportStatus  @default(DRAFT)
  publishedAt     DateTime?
  updatedAt       DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term     Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
  @@index([tenantId, classArmId, termId])
  @@map("report_cards")
}

// ============================================================== timetable
//
// The solver (src/timetable/solver.ts) places each class's weekly lessons
// (ClassSubject.periodsPerWeek) into the bell schedule without double-booking
// a class, teacher or room, then improves spread and balance. AI explains
// what couldn't be placed and turns plain-English requests into constraints.

model Room {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  /// CLASSROOM, LAB, ICT, HALL, LIBRARY, WORKSHOP…
  kind      String   @default("CLASSROOM")
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([tenantId, name])
  @@map("rooms")
}

/// A period in the week when a teacher can't be timetabled.
model StaffUnavailability {
  id       String @id @default(cuid())
  tenantId String
  staffId  String
  /// 1 = Monday … 7 = Sunday
  day      Int
  /// Index into the bell schedule's periods.
  period   Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, day, period])
  @@index([tenantId])
  @@map("staff_unavailability")
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Timetable {
  id              String          @id @default(cuid())
  tenantId        String
  termId          String
  name            String
  status          TimetableStatus @default(DRAFT)
  generation      GenerationState @default(NONE)
  generationError String?
  /// The bell schedule it was built against (so later edits don't shift it).
  bellSchedule    Json
  /// Solver report: placed/unplaced counts, reasons, quality scores.
  report          Json?
  createdById     String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term    Term             @relation(fields: [termId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@index([tenantId, termId])
  @@map("timetables")
}

model TimetableEntry {
  id          String  @id @default(cuid())
  tenantId    String
  timetableId String
  classArmId  String
  subjectId   String
  teacherId   String?
  roomId      String?
  day         Int
  period      Int
  /// Part of a double lesson: both halves share a group id.
  doubleGroup String?
  /// Kept in place when the timetable is regenerated.
  locked      Boolean @default(false)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  classArm  ClassArm  @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Staff?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([timetableId, classArmId, day, period])
  @@index([timetableId, teacherId])
  @@index([tenantId])
  @@map("timetable_entries")
}

// ============================================================== attendance

/// One class's daily register. Rates are computed over registers taken, so
/// a missing register never counts as absence.
model AttendanceRegister {
  id         String   @id @default(cuid())
  tenantId   String
  classArmId String
  date       DateTime @db.Date
  takenById  String?
  takenAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArm ClassArm            @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  marks    StudentAttendance[]

  @@unique([classArmId, date])
  @@index([tenantId, date])
  @@map("attendance_registers")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model StudentAttendance {
  id         String           @id @default(cuid())
  tenantId   String
  registerId String
  studentId  String
  /// Copied from the register so per-student history needs no join.
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  student  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([registerId, studentId])
  @@index([tenantId, studentId, date])
  @@map("student_attendance")
}

enum StaffAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

model StaffAttendance {
  id         String                @id @default(cuid())
  tenantId   String
  staffId    String
  date       DateTime              @db.Date
  status     StaffAttendanceStatus
  checkInAt  DateTime?
  checkOutAt DateTime?
  /// KIOSK (QR check-in) or MANUAL (entered by a manager).
  method     String                @default("MANUAL")
  note       String?
  updatedAt  DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([tenantId, date])
  @@map("staff_attendance")
}

// ============================================================== finance
//
// Money is stored in the currency's minor unit (kobo for NGN) as integers,
// so no amount is ever a floating-point number.

/// A charge on a term's fee schedule, for all classes or chosen class levels.
model FeeItem {
  id            String   @id @default(cuid())
  tenantId      String
  termId        String
  name          String
  /// TUITION, LEVY, BOOKS, UNIFORM, TRANSPORT, BOARDING, EXAM, LAB, ICT, OTHER
  category      String   @default("TUITION")
  amountKobo    Int
  /// Empty = every class level.
  classLevelIds String[]
  /// Optional items are only added to an invoice on request (e.g. transport).
  optional      Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term   Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  lines  InvoiceLine[]

  @@index([tenantId, termId])
  @@map("fee_items")
}

enum InvoiceStatus {
  ISSUED
  PART_PAID
  PAID
  CANCELLED
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  studentId   String
  termId      String
  number      String
  status      InvoiceStatus @default(ISSUED)
  /// Sum of the lines (discounts are negative lines).
  totalKobo   Int
  paidKobo    Int           @default(0)
  dueDate     DateTime      @db.Date
  note        String?
  createdById String?
  issuedAt    DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term     Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  lines    InvoiceLine[]
  payments Payment[]

  @@unique([tenantId, number])
  @@unique([studentId, termId])
  @@index([tenantId, termId, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  tenantId    String
  invoiceId   String
  feeItemId   String?
  description String
  /// FEE, DISCOUNT (negative amount) or FINE
  kind        String  @default("FEE")
  amountKobo  Int

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem FeeItem? @relation(fields: [feeItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_lines")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceId     String
  studentId     String
  amountKobo    Int
  /// CASH, BANK_TRANSFER, POS, CHEQUE, PAYSTACK
  method        String
  status        PaymentStatus @default(SUCCESS)
  /// Teller number, transfer reference, or the Paystack reference.
  reference     String?
  receiptNumber String?
  payerName     String?
  payerEmail    String?
  paidAt        DateTime      @default(now())
  receivedById  String?
  note          String?
  createdAt     DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, reference, method])
  @@index([tenantId, paidAt])
  @@index([invoiceId])
  @@map("payments")
}

model Expense {
  id           String   @id @default(cuid())
  tenantId     String
  /// SALARIES, UTILITIES, FUEL, MAINTENANCE, SUPPLIES, TRANSPORT, EVENTS, FEEDING, OTHER
  category     String
  description  String
  amountKobo   Int
  spentOn      DateTime @db.Date
  paidTo       String?
  method       String?
  reference    String?
  recordedById String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, spentOn])
  @@map("expenses")
}

/// A school's connection to an outside service. Secrets are encrypted at rest
/// with APP_ENCRYPTION_KEY and never returned by the API.
model TenantIntegration {
  id              String   @id @default(cuid())
  tenantId        String
  /// "paystack"
  provider        String
  publicKey       String?
  secretEncrypted String
  /// Last four characters of the secret, to show which key is saved.
  secretHint      String
  isLive          Boolean  @default(false)
  /// Non-secret settings (SMTP host and sender, SMS sender ID, WhatsApp template…).
  config          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("tenant_integrations")
}

// ============================================================== hr & payroll

/// Academic departments (Sciences, Languages…) and support units (Admin, Facilities).
model Department {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  headStaffId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  head   Staff?  @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  staff  Staff[] @relation("DepartmentStaff")

  @@unique([tenantId, name])
  @@map("departments")
}

/// A salary structure: monthly amounts in kobo that a pay profile starts from.
model SalaryGrade {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  basicKobo       Int
  housingKobo     Int      @default(0)
  transportKobo   Int      @default(0)
  /// [{ label, amountKobo }]
  otherAllowances Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profiles StaffPayProfile[]

  @@unique([tenantId, name])
  @@map("salary_grades")
}

/// An employee's monthly pay, bank and statutory details.
model StaffPayProfile {
  id              String   @id @default(cuid())
  tenantId        String
  staffId         String   @unique
  gradeId         String?
  basicKobo       Int
  housingKobo     Int      @default(0)
  transportKobo   Int      @default(0)
  otherAllowances Json     @default("[]")
  pensionEnabled  Boolean  @default(true)
  nhfEnabled      Boolean  @default(false)
  /// For rent relief on PAYE.
  annualRentKobo  Int      @default(0)
  bankName        String?
  accountNumber   String?
  accountName     String?
  pfaName         String?
  pensionPin      String?
  taxId           String?
  updatedAt       DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  grade  SalaryGrade? @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("staff_pay_profiles")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

/// One month's payroll. Payslips copy the pay details when prepared, so a
/// later salary change never alters an approved month.
model PayrollRun {
  id           String        @id @default(cuid())
  tenantId     String
  /// YYYY-MM
  period       String
  status       PayrollStatus @default(DRAFT)
  workingDays  Int
  note         String?
  preparedById String?
  approvedById String?
  approvedAt   DateTime?
  paidOn       DateTime?     @db.Date
  payMethod    String?
  payReference String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([tenantId, period])
  @@map("payroll_runs")
}

model Payslip {
  id                  String   @id @default(cuid())
  tenantId            String
  runId               String
  staffId             String
  staffName           String
  staffNumber         String
  jobTitle            String
  department          String?
  bankName            String?
  accountNumber       String?
  accountName         String?
  pfaName             String?
  pensionPin          String?
  taxId               String?
  basicKobo           Int
  housingKobo         Int
  transportKobo       Int
  otherAllowances     Json     @default("[]")
  pensionEnabled      Boolean
  nhfEnabled          Boolean
  annualRentKobo      Int      @default(0)
  unpaidLeaveDays     Int      @default(0)
  /// [{ kind: EARNING | DEDUCTION, label, amountKobo }]
  adjustments         Json     @default("[]")
  /// Worked-out lines, [{ label, amountKobo }]
  earnings            Json     @default("[]")
  deductions          Json     @default("[]")
  grossKobo           Int
  payeKobo            Int
  pensionKobo         Int
  nhfKobo             Int
  otherDeductionsKobo Int
  netKobo             Int
  employerPensionKobo Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  staff  Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([runId, staffId])
  @@index([tenantId, staffId])
  @@map("payslips")
}

model LeaveType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// Working days per calendar year.
  daysPerYear Int
  paid        Boolean  @default(true)
  /// ALL, FEMALE or MALE
  appliesTo   String   @default("ALL")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]

  @@unique([tenantId, name])
  @@map("leave_types")
}

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

model LeaveRequest {
  id            String      @id @default(cuid())
  tenantId      String
  staffId       String
  leaveTypeId   String
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  /// Working days (Mon–Fri) in the range.
  days          Int
  reason        String?
  status        LeaveStatus @default(PENDING)
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([staffId, startDate])
  @@map("leave_requests")
}

model Award {
  id          String   @id @default(cuid())
  tenantId    String
  staffId     String
  title       String
  /// EXCELLENCE, TEACHER_OF_TERM, PUNCTUALITY, LONG_SERVICE, INNOVATION, SERVICE, OTHER
  category    String
  citation    String?
  prize       String?
  awardedOn   DateTime @db.Date
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, awardedOn])
  @@map("awards")
}

// ============================================================== library

model LibraryBook {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  author        String
  isbn          String?
  /// TEXTBOOK, FICTION, NON_FICTION, REFERENCE, AFRICAN_LITERATURE, SCIENCE, MAGAZINE, OTHER
  category      String
  publisher     String?
  publishedYear Int?
  shelf         String?
  subject       String?
  level         String?
  copies        Int      @default(1)
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans  LibraryLoan[]

  @@index([tenantId, title])
  @@map("library_books")
}

/// A book lent to one student or one member of staff.
model LibraryLoan {
  id         String    @id @default(cuid())
  tenantId   String
  bookId     String
  studentId  String?
  staffId    String?
  issuedOn   DateTime  @db.Date
  dueOn      DateTime  @db.Date
  returnedOn DateTime? @db.Date
  /// Charged on return (after any waiver).
  fineKobo   Int       @default(0)
  finePaid   Boolean   @default(false)
  note       String?
  issuedById String?
  createdAt  DateTime  @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book    LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff   Staff?      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, returnedOn])
  @@index([bookId])
  @@map("library_loans")
}

// ============================================================== inventory

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  category     String
  unit         String   @default("pcs")
  sku          String?
  location     String?
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  unitCostKobo Int      @default(0)
  isAsset      Boolean  @default(false)
  /// NEW, GOOD, FAIR, POOR, BROKEN (assets)
  condition    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([tenantId, name])
  @@map("inventory_items")
}

model StockMovement {
  id           String   @id @default(cuid())
  tenantId     String
  itemId       String
  /// IN, OUT, ADJUST
  kind         String
  /// Signed change in stock.
  change       Int
  balanceAfter Int
  unitCostKobo Int?
  reason       String?
  issuedTo     String?
  supplier     String?
  movedOn      DateTime @db.Date
  recordedById String?
  expenseId    String?
  createdAt    DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, movedOn])
  @@index([itemId, createdAt])
  @@map("stock_movements")
}

// ============================================================== transport

model Vehicle {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  plateNumber   String
  capacity      Int
  driverName    String?
  driverPhone   String?
  assistantName String?
  /// ACTIVE, MAINTENANCE, RETIRED
  status        String   @default("ACTIVE")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routes TransportRoute[]

  @@unique([tenantId, plateNumber])
  @@map("vehicles")
}

model TransportRoute {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  vehicleId String?
  /// [{ name, pickup: "06:45", dropoff: "15:40" }] in route order
  stops     Json     @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  assignments TransportAssignment[]

  @@unique([tenantId, name])
  @@map("transport_routes")
}

/// A student's place on a route (one route per student).
model TransportAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String   @unique
  routeId   String
  stop      String
  /// BOTH, MORNING, AFTERNOON
  direction String   @default("BOTH")
  createdAt DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([tenantId, routeId])
  @@map("transport_assignments")
}

// ============================================================== hostel

model Hostel {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  /// MALE, FEMALE, MIXED
  gender        String
  wardenStaffId String?
  notes         String?
  createdAt     DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warden Staff?       @relation(fields: [wardenStaffId], references: [id], onDelete: SetNull)
  rooms  HostelRoom[]

  @@unique([tenantId, name])
  @@map("hostels")
}

model HostelRoom {
  id       String @id @default(cuid())
  tenantId String
  hostelId String
  name     String
  beds     Int

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel      Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allocations HostelAllocation[]

  @@unique([hostelId, name])
  @@map("hostel_rooms")
}

/// A boarder's bed. Ending an allocation keeps it as history.
model HostelAllocation {
  id        String    @id @default(cuid())
  tenantId  String
  roomId    String
  studentId String
  bed       Int?
  fromDate  DateTime  @db.Date
  toDate    DateTime? @db.Date
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room    HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([studentId])
  @@map("hostel_allocations")
}

/// Permission for a boarder to leave school, and their return.
model Exeat {
  id               String    @id @default(cuid())
  tenantId         String
  studentId        String
  leaveAt          DateTime
  expectedReturnAt DateTime
  returnedAt       DateTime?
  reason           String
  collectedBy      String
  approvedById     String?
  createdAt        DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, returnedAt])
  @@map("exeats")
}

// ============================================================== reception

model Visitor {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  phone        String?
  organisation String?
  purpose      String
  hostStaffId  String?
  hostName     String?
  badgeNumber  String?
  vehiclePlate String?
  checkInAt    DateTime  @default(now())
  checkOutAt   DateTime?
  recordedById String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host   Staff? @relation("VisitorHost", fields: [hostStaffId], references: [id], onDelete: SetNull)

  @@index([tenantId, checkInAt])
  @@map("visitors")
}

model Enquiry {
  id              String    @id @default(cuid())
  tenantId        String
  parentName      String
  phone           String
  email           String?
  childName       String?
  classOfInterest String?
  entryTerm       String?
  /// WALK_IN, PHONE, WHATSAPP, WEBSITE, REFERRAL, SOCIAL, OTHER
  source          String    @default("WALK_IN")
  /// NEW, CONTACTED, VISIT_BOOKED, APPLIED, ENROLLED, CLOSED
  status          String    @default("NEW")
  question        String?
  notes           String?
  followUpOn      DateTime? @db.Date
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("enquiries")
}

/// A student collected before the end of the school day.
model StudentPickup {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  collectedBy  String
  relationship String
  phone        String?
  reason       String
  onRecord     Boolean  @default(false)
  at           DateTime @default(now())
  recordedById String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
  @@map("student_pickups")
}

// ============================================================== certificates

model Certificate {
  id            String    @id @default(cuid())
  tenantId      String
  /// e.g. GIS/CERT/2026/0007, unique within the school
  serial        String
  /// Random public code for the verification page.
  code          String    @unique
  /// TESTIMONIAL, TRANSFER, MERIT, ATTENDANCE, COMPLETION, SERVICE
  kind          String
  studentId     String?
  staffId       String?
  recipientName String
  /// Class or job title when issued.
  recipientInfo String?
  title         String
  body          String
  issuedOn      DateTime  @db.Date
  issuedById    String?
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime  @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([tenantId, serial])
  @@map("certificates")
}

// ============================================================== communication

/// One message to many people over one or more channels.
model Broadcast {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  /// ["EMAIL", "SMS", "WHATSAPP", "PUSH", "IN_APP"]
  channels        String[]
  /// The audience definition (see audienceSchema).
  audience        Json
  audienceSummary String
  subject         String?
  body            String
  smsBody         String?
  link            String?
  /// DRAFT, SCHEDULED, SENDING, SENT, CANCELLED
  status          String    @default("DRAFT")
  /// MANUAL, BIRTHDAY, EVENT_REMINDER, ANNOUNCEMENT, TRANSPORT, FEES, ENQUIRY
  source          String    @default("MANUAL")
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([tenantId, createdAt])
  @@index([status, scheduledAt])
  @@map("broadcasts")
}

/// One message to one person on one channel.
model Delivery {
  id            String    @id @default(cuid())
  tenantId      String
  broadcastId   String
  channel       String
  recipientName String
  /// Email address, phone number (234…), or user id for push/in-app.
  address       String?
  guardianId    String?
  staffId       String?
  userId        String?
  /// Personalised text actually sent.
  subject       String?
  text          String
  /// QUEUED, SENT, FAILED, SKIPPED
  status        String    @default("QUEUED")
  error         String?
  providerRef   String?
  /// SMS pages billed.
  units         Int       @default(0)
  attempts      Int       @default(0)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([status, createdAt])
  @@index([tenantId, sentAt])
  @@map("deliveries")
}

model Announcement {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  body        String
  /// EVERYONE, STAFF, PARENTS, STUDENTS
  audience    String    @default("EVERYONE")
  classArmIds String[]
  pinned      Boolean   @default(false)
  publishAt   DateTime  @default(now())
  expiresAt   DateTime?
  broadcastId String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, publishAt])
  @@map("announcements")
}

model SchoolEvent {
  id               String    @id @default(cuid())
  tenantId         String
  title            String
  description      String?
  /// ACADEMIC, EXAM, HOLIDAY, PTA, SPORTS, CULTURAL, MEETING, TRIP, OTHER
  category         String    @default("OTHER")
  allDay           Boolean   @default(false)
  startDate        DateTime  @db.Date
  /// HH:MM school time
  startTime        String?
  endDate          DateTime? @db.Date
  endTime          String?
  location         String?
  audience         String    @default("EVERYONE")
  classArmIds      String[]
  remindDaysBefore Int?
  reminderSentAt   DateTime?
  showOnWebsite    Boolean   @default(false)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate])
  @@map("school_events")
}

/// A browser that accepts push notifications for a user (any school).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// One automated send (a birthday, an event reminder) so it never repeats.
model AutomationRun {
  id          String   @id @default(cuid())
  tenantId    String
  /// BIRTHDAY_STUDENT, BIRTHDAY_STAFF, EVENT_REMINDER
  kind        String
  subjectKey  String
  runDate     DateTime @db.Date
  broadcastId String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, subjectKey, runDate])
  @@map("automation_runs")
}

// ============================================================== live learning

/// A live lesson on Google Meet, Zoom, BigBlueButton or any meeting link.
model LiveClass {
  id                String    @id @default(cuid())
  tenantId          String
  title             String
  classArmId        String
  subjectId         String?
  teacherId         String?
  lessonPlanId      String?
  /// GOOGLE_MEET, ZOOM, BBB, EXTERNAL
  provider          String
  /// SCHEDULED, LIVE, ENDED, CANCELLED
  status            String    @default("SCHEDULED")
  startsAt          DateTime
  endsAt            DateTime
  agenda            String?
  joinUrl           String?
  /// The provider's id: calendar event id, Zoom meeting id, BBB meetingID.
  externalId        String?
  /// Provider details kept server-side (Meet code, Zoom start URL and passcode, BBB passwords).
  providerData      Json?
  transcript        String?
  /// PROVIDER, UPLOAD, NOTES
  transcriptSource  String?
  teacherNotes      String?
  intelligence      Json?
  intelligenceJobId String?
  /// When the teacher shared the AI summary with students and parents.
  summarySharedAt   DateTime?
  homeworkId        String?
  quizQuestionIds   String[]
  syncedAt          DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArm   ClassArm         @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject    Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher    Staff?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  lessonPlan LessonPlan?      @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)
  attendance LiveAttendance[]
  recordings LiveRecording[]

  @@index([tenantId, startsAt])
  @@index([classArmId, startsAt])
  @@map("live_classes")
}

model LiveAttendance {
  id          String    @id @default(cuid())
  tenantId    String
  liveClassId String
  studentId   String
  /// PRESENT, LATE, ABSENT
  status      String
  joinedAt    DateTime?
  leftAt      DateTime?
  minutes     Int?
  /// PORTAL, PROVIDER, MANUAL
  source      String    @default("MANUAL")
  updatedAt   DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, studentId])
  @@index([tenantId])
  @@map("live_attendance")
}

model LiveRecording {
  id              String    @id @default(cuid())
  tenantId        String
  liveClassId     String
  /// VIDEO, AUDIO, TRANSCRIPT, CHAT
  kind            String
  title           String
  url             String
  durationSeconds Int?
  startedAt       DateTime?
  externalId      String
  createdAt       DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, externalId])
  @@index([tenantId])
  @@map("live_recordings")
}

/// Homework set for a class, by hand or from a live class's AI summary.
model Homework {
  id           String    @id @default(cuid())
  tenantId     String
  classArmId   String
  subjectId    String?
  teacherId    String?
  liveClassId  String?
  title        String
  instructions String
  questions    String[]
  dueDate      DateTime  @db.Date
  /// DRAFT, PUBLISHED
  status       String    @default("DRAFT")
  /// MANUAL, AI
  source       String    @default("MANUAL")
  publishedAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classArm ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subject  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher  Staff?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([tenantId, classArmId, dueDate])
  @@map("homework")
}

// ============================================================== website

model WebsitePost {
  id          String    @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  excerpt     String?
  body        String
  /// NEWS, ACHIEVEMENT, EVENT, ANNOUNCEMENT, BLOG
  category    String    @default("NEWS")
  coverUrl    String?
  /// DRAFT, PUBLISHED
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
