Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
# /api belongs to the Node.js app (Passenger); never rewrite it.
RewriteRule ^api(/|$) - [L]
# Sales pages: a copy of the app shell carrying their own share-preview (Open Graph) tags.
RewriteRule ^for-schools/?$ og/for-schools.html [L]
RewriteRule ^for-schools/deck/?$ og/for-schools-deck.html [L]
RewriteRule ^for-schools/calculator/?$ og/for-schools-calculator.html [L]
RewriteRule ^for-boards/?$ og/for-boards.html [L]
RewriteRule ^ambassadors/?$ og/ambassadors.html [L]
# The portal's own front page (the product landing page for signed-out visitors): its share-preview copy.
# Only on the portal host: a school's own website domain served from here keeps the plain app shell.
RewriteCond %{HTTP_HOST} ^ai-schoolportal\.mejortechworld\.com$ [NC]
RewriteRule ^$ og/home.html [L]
# Real files and folders are served as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Everything else is a client-side route.
RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
# Android app links (/.well-known/assetlinks.json) must be served as JSON.
AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
# Hashed build assets never change: cache for a year.
<FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# The app shell must always be fresh so new deploys load immediately.
# The service worker too (it isn't hashed), so notification fixes reach browsers.
# Every HTML page (index.html, the og/ share-preview copies) is an app shell.
<FilesMatch "(\.html|^sw\.js)$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
# The installable-app manifest: checked each time (it is tiny) so name/icon changes reach phones.
<FilesMatch "^manifest\.webmanifest$">
Header set Cache-Control "no-cache"
</FilesMatch>
# App icons keep their names between deploys, so they can't be cached forever.
<FilesMatch "^(icon-\d+|maskable-\d+|badge-\d+|apple-touch-icon)\.png$|^icon\.svg$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
# Android app links: re-checked by phones, so a new signing fingerprint takes effect within the hour.
<FilesMatch "^assetlinks\.json$">
Header set Cache-Control "public, max-age=3600"
Header set Access-Control-Allow-Origin "*"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"

# The web app's own security headers. /api answers with its own (helmet), so leave those alone.
<IfModule mod_setenvif.c>
SetEnvIf Request_URI "^/api(/|$)" AIS_API_REQUEST
</IfModule>
# No includeSubDomains: a school's own website domain can be served from here too, and its
# other subdomains (mail, etc.) are not ours to force onto HTTPS.
Header always set Strict-Transport-Security "max-age=31536000" env=!AIS_API_REQUEST
# Report-only for launch: browsers log what it would block, without blocking. Switch to
# Content-Security-Policy once the reports are clean.
# What the app loads: its own code; the theme script in index.html (by hash — update the hash
# below if that script changes); Google Fonts; YouTube (lesson videos: iframe + iframe_api);
# map tiles and school logos as https images; blob:/data: for previews, downloads, 3D lab textures,
# voice clips and PDF previews; the service worker. Payments (Paystack) are full-page redirects.
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-UZn1hIWLWZWEeiy3YoOHAPkjHr9Udo7JNpTYjqcF+P0=' https://www.youtube.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' blob: data: https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" env=!AIS_API_REQUEST
# Driver GPS (geolocation), gate scanner (camera), voice tutor (microphone), kiosk/bus screen
# wake lock and fullscreen exams; YouTube embeds keep fullscreen/autoplay/PiP. Everything else off.
Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(self), screen-wake-lock=(self), fullscreen=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), autoplay=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), encrypted-media=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), picture-in-picture=(self \"https://www.youtube-nocookie.com\" \"https://www.youtube.com\"), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), display-capture=(), xr-spatial-tracking=(), browsing-topics=()" env=!AIS_API_REQUEST
</IfModule>
