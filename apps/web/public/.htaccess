Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
# /api belongs to the Node.js app (Passenger); never rewrite it.
RewriteRule ^api(/|$) - [L]
# Real files and folders are served as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Everything else is a client-side route.
RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
# Hashed build assets never change: cache for a year.
<FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# The app shell must always be fresh so new deploys load immediately.
<FilesMatch "(^index\.html|\.htaccess)$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
