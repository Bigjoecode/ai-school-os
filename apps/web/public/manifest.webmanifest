{
  "id": "/",
  "name": "AI School OS",
  "short_name": "AI School",
  "description": "Your school in your pocket: homework, results, attendance, fees and the AI tutor — even on a weak connection.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b1330",
  "theme_color": "#0b1330",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "related_applications": [{ "platform": "play", "id": "com.mejortechworld.aischool", "url": "https://play.google.com/store/apps/details?id=com.mejortechworld.aischool" }],
  "screenshots": [
    { "src": "/screenshots/parent-home.webp", "sizes": "1080x1920", "type": "image/webp", "form_factor": "narrow", "label": "A parent's home screen: attendance, latest result, next exam and fees" },
    { "src": "/screenshots/student-home.webp", "sizes": "1080x1920", "type": "image/webp", "form_factor": "narrow", "label": "A student's home screen with the daily challenge" },
    { "src": "/screenshots/student-tutor.webp", "sizes": "1080x1920", "type": "image/webp", "form_factor": "narrow", "label": "The AI tutor" }
  ],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Homework",
      "short_name": "Homework",
      "description": "Homework set and due",
      "url": "/?shortcut=homework",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "AI tutor",
      "short_name": "AI tutor",
      "description": "Ask the AI tutor for help",
      "url": "/?shortcut=tutor",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Fees",
      "short_name": "Fees",
      "description": "School fees and payments",
      "url": "/?shortcut=fees",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Attendance",
      "short_name": "Attendance",
      "description": "Attendance records",
      "url": "/?shortcut=attendance",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
